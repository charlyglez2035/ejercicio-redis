JWT_SECRET=
JWT_ISSUER=library-login
JWT_AUDIENCE=library-book
JWT_EXPIRES_IN_SECONDS=1200
REFRESH_TOKEN_TTL_SECONDS=1800
REDIS_URL=redis://:cambia-esta-password@localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
BOOKS_CACHE_TTL_SECONDS=60
BOOKS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SERVICE_PORT=5001
MONOLITH_PUBLIC_URL=http://localhost:3000
# book no lee el .env raiz: define aqui la conexion PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library
DB_USER=library_user
DB_PASSWORD=tu_password_de_postgres
