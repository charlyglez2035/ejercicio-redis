# Mismo JWT_SECRET (>= 32 bytes) y REDIS_URL que login y book. No versiones el .env.
JWT_SECRET=
JWT_ISSUER=library-login
JWT_AUDIENCE=library-book
JWT_EXPIRES_IN_SECONDS=1200
REFRESH_TOKEN_TTL_SECONDS=1800
REDIS_URL=redis://:cambia-esta-password@localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
SERVICE_HOST=0.0.0.0
SERVICE_PORT=5004
PEDIDOS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DB_HOST, DB_PORT, DB_NAME, DB_USER y DB_PASSWORD se leen del .env raiz si no se definen aqui.
